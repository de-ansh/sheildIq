# Copy to .env and fill in. .env is git-ignored.
# Anything other than NODE_ENV=development (or test) runs with production safety:
# Secure cookies, no demo account, no reset links in logs. `pnpm dev` sets development for you.
# NODE_ENV=development
# Create the demo account (alex.vance@shieldiq.internal / Password123!) outside development:
# SEED_DEMO=true
PORT=5001
# Comma-separated frontend origins allowed to call the API with cookies
CORS_ORIGIN=http://localhost:5173
# Used to build password-reset links
APP_URL=http://localhost:5173
# Set to the number of proxy hops (e.g. 1) when running behind a reverse proxy
# TRUST_PROXY=1

# AI strategy: Gemini is tried first, OpenAI is the fallback. Set at least one.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# AI cost controls (counted only on real provider calls, never cache hits)
# AI_DAILY_CALL_LIMIT=500   # all users combined, per 24 hours
# AI_IP_HOURLY_LIMIT=60     # per IP address, across all AI features
