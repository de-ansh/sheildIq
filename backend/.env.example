# Copy to .env and fill in. .env is git-ignored.
# Anything other than NODE_ENV=development (or test) runs with production safety:
# Secure cookies, no demo account, no reset links in logs. `pnpm dev` sets development for you.
# NODE_ENV=development
# Create the demo account (alex.vance@shieldiq.internal / Password123!) outside development:
# SEED_DEMO=true
PORT=5001
# Postgres connection. Set by docker-compose.yml when running in Docker. Without it, the backend uses an
# embedded Postgres (PGlite) stored in ./data/pglite (or PGLITE_DIR), which needs no server.
# DATABASE_URL=postgres://shieldiq:shieldiq-dev@localhost:5432/shieldiq
# DATABASE_POOL_SIZE=10
# Comma-separated frontend origins allowed to call the API with cookies
CORS_ORIGIN=http://localhost:5173
# Used to build password-reset links
APP_URL=http://localhost:5173
# Sign-in attempts allowed per IP / per account in 15 minutes (default 10). Raise only for automated tests.
# AUTH_RATE_LIMIT_MAX=10
# Set to the number of proxy hops (e.g. 1) when running behind a reverse proxy
# TRUST_PROXY=1
# Send server errors to Sentry (project DSN from Sentry's project settings). Unset: errors only go to the log.
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/<project-id>

# AI strategy: Gemini is tried first, OpenAI is the fallback. Set at least one.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# AI cost controls (counted only on real provider calls, never cache hits)
# AI_DAILY_CALL_LIMIT=500   # all users combined, per 24 hours
# AI_IP_HOURLY_LIMIT=60     # per IP address, across all AI features
